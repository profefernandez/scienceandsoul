# Copy to .env on the server and fill in real values. Never commit .env.

# --- Required ---
NODE_ENV=production
PORT=8080

# Optional Postgres connection reserved for future server features
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:6543/DB_NAME

# --- Optional ---
# Absolute path to the built frontend (defaults to ../science-and-soul/dist/public
# relative to the api-server dist folder — correct if you deploy the whole repo)
# STATIC_DIR=/home/youruser/app/artifacts/science-and-soul/dist/public
