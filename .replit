modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y-home"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y-privacy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y-hipaa"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y-accessibility"

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/science-and-soul && pnpm run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "a11y-home"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/science-and-soul/scripts/a11y-validate.sh / 4181"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "a11y-privacy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/science-and-soul/scripts/a11y-validate.sh /privacy 4182"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "a11y-hipaa"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/science-and-soul/scripts/a11y-validate.sh /hipaa 4183"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "a11y-accessibility"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/science-and-soul/scripts/a11y-validate.sh /accessibility 4184"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23173
externalPort = 3000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-6e5326c1-d863-4ea6-9691-8964f2f7c14b"

[userenv]

[userenv.shared]
